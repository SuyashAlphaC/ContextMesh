# No secrets are required for the local, clearly labeled simulation.
PORT=4310
PUBLIC_URL=http://localhost:5173
CONTEXTMESH_MODE=demo
DATA_DIR=./data
# Required when exposing the app beyond localhost. Shared single-workspace access.
APP_ACCESS_TOKEN=
WORKFLOW_CALLBACK_TOKEN=

# sandbox enables real PayPal Sandbox APIs; never production payments.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MAYA_EMAIL=
PAYPAL_ARJUN_EMAIL=

# Optional real LLM; absent keys use an explicitly labeled deterministic parser.
# auto prefers Gemini when its key is present, otherwise Anthropic, otherwise simulation.
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Open-source HydraDB HTTP API (not the separate managed memory API).
HYDRADB_URL=
HYDRADB_TOKEN=
HYDRADB_NAMESPACE=default
HYDRADB_GRAPH=default
HYDRADB_CELL=cell-0

# Set both to enable remote Render Workflows dispatch.
RENDER_API_KEY=
RENDER_TASK_SLUG=
WORKFLOW_CALLBACK_URL=

# Obtain an AG Studio trial covering AI. VITE_ keys are public license values only.
VITE_AG_STUDIO_LICENSE_KEY=
